{
  "name": "@movogo-io/dynamodb-docs",
  "type": "module",
  "version": "0.1.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/movogo-io/node-dynamodb-docs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "*.js",
    "lib/*.js",
    "*.d.ts",
    "lib/*.d.ts"
  ],
  "sideEffects": [
    "./partitioned.js"
  ],
  "exports": {
    ".": "./partitioned.js",
    "./schema": "./schema.js"
  },
  "scripts": {
    "start": "riddance-watch",
    "prepack": "riddance-build",
    "prepublishOnly": "riddance-prepublish",
    "postpublish": "riddance-sync"
  },
  "dependencies": {
    "@movogo-io/docs": "^0.1.0",
    "@riddance/fetch": "0.1.5",
    "@smithy/signature-v4": "5.6.12"
  },
  "devDependencies": {
    "@riddance/env": "0.10.2"
  },
  "allowScripts": {
    "@riddance/env": true
  }
}
